{
  "name": "shorts-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faceless YouTube Shorts pipeline: Remotion (money, history) + Manim (space)",
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "render": "node tools/render.mjs",
    "check": "node tools/render.mjs all --check",
    "studio": "remotion studio src/index.ts",
    "test": "node --test tests/pipeline.test.mjs",
    "render3d": "node tools/render3d.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/fonts": "^4.0.541",
    "@remotion/layout-utils": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@remotion/shapes": "^4.0.541",
    "js-yaml": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
